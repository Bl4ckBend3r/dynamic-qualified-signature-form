FLASK_DEBUG=false
SECRET_KEY=
SERVICE_NAME=dynamic-qualified-signature-form
LOG_FORMAT=text
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_TOKEN=
TRUSTED_PROXY_HOPS=0
DATABASE_URL=
AUTO_DB_MIGRATE=false

POSTGRES_DB=formularze
POSTGRES_USER=formularze
POSTGRES_PASSWORD=

NEXTCLOUD_BASE_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_FORMS_DIR=Strona WWW/Formularze
NEXTCLOUD_OUTPUT_DIR=Strona WWW/output
NEXTCLOUD_VERIFY_SSL=true
NEXTCLOUD_CA_BUNDLE=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

SIGNATURE_PROVIDER=mock
SIGNATURE_MOCK_MODE=signed
# Signature validation trust material (paths separated by ;).
# These are separate from NEXTCLOUD_CA_BUNDLE, which secures the WebDAV transport.
SIGNATURE_TRUST_ROOTS=
SIGNATURE_INTERMEDIATE_CERTS=
SIGNATURE_CRL_FILES=
SIGNATURE_ALLOW_FETCHING=false
# Optional diagnostics only; never vetoes the minimal Trusted Profile verifier.
TRUSTED_PROFILE_PYHANKO_DIAGNOSTIC=true

FORM_NOTIFICATION_EMAILS=
CSV_FILENAME=dane.csv
TEMP_DIR=/tmp/formularze
