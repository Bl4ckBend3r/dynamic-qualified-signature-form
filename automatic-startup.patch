+"""Run the existing document rename migration at normal application startup."""
+
+import json
+import os
+
+
+_TRUE = {"1", "true", "yes", "tak", "on"}
+
+
+def _enabled(app):
+    # Production starts opt in by default. Local runs must explicitly opt in.
+    production = str(app.config.get("ENV") or os.getenv("FLASK_ENV", "")).strip().lower() == "production"
+    value = os.getenv("AUTO_RENAME_UPLOADED_DOCUMENTS")
+    if value is None:
+        value = app.config.get("AUTO_RENAME_UPLOADED_DOCUMENTS", production)
+    return str(value).strip().lower() in _TRUE
+
+
+def run_startup_document_rename(app, container, readiness_check):
+    """Synchronous, idempotent migration using the application's real services.
+
+    No schema changes, fallback storage writes, or unverified TLS. A failed
+    migration is logged; it must not make the entire application unavailable.
+    The existing database advisory lock serializes migration processes.
+    """
+    log = app.logger
+    if app.config.get("TESTING") or not _enabled(app):
+        log.info("document_rename_startup_skipped reason=disabled_or_testing")
+        return
+
+    try:
+        from sqlalchemy import inspect
+        from models import UploadedDocumentRename
+        from services.nextcloud_storage import NextcloudStorage
+        from scripts.rename_uploaded_documents import (
+            RenameError, UploadedDocumentRenamer, _automatic_migration,
+        )
+
+        storage = container.storage
+        if not isinstance(storage, NextcloudStorage):
+            log.warning("document_rename_startup_skipped reason=not_direct_nextcloud")
+            return
+        if not getattr(storage, "verify_ssl", False):
+            log.error("document_rename_startup_skipped reason=TLS_VERIFICATION_DISABLED")
+            return
+        if readiness_check(app.config.get("DATABASE_URL"))["status"] != "ready":
+            log.error("document_rename_startup_skipped reason=DATABASE_NOT_READY")
+            return
+
+        # Use the exact session factory and storage used by the application.
+        sessions = container.submission_repository.session_factory
+        engine = sessions.kw["bind"]
+        if engine.dialect.name not in {"mysql", "mariadb", "postgresql"}:
+            log.warning("document_rename_startup_skipped reason=UNSUPPORTED_DATABASE")
+            return
+        table = UploadedDocumentRename.__tablename__
+        inspector = inspect(engine)
+        if not inspector.has_table(table):
+            log.error("document_rename_startup_skipped reason=MISSING_JOURNAL")
+            return
+        expected = {column.name for column in UploadedDocumentRename.__table__.columns}
+        actual = {column["name"] for column in inspector.get_columns(table)}
+        if not expected.issubset(actual):
+            log.error("document_rename_startup_skipped reason=INCOMPLETE_JOURNAL_SCHEMA")
+            return
+
+        log.info("document_rename_startup_started")
+        try:
+            report = _automatic_migration(UploadedDocumentRenamer(sessions, storage))
+        except RenameError as exc:
+            if exc.code == "MIGRATION_LOCKED":
+                log.info("document_rename_startup_skipped reason=MIGRATION_LOCKED")
+                return
+            log.error("document_rename_startup_failed reason=%s", exc.code)
+            return
+        # The existing report contains identifiers and reason codes, not PDF names.
+        if report.get("errors"):
+            log.error("document_rename_startup_failed report=%s", json.dumps(report, ensure_ascii=True))
+        else:
+            log.info("document_rename_startup_completed report=%s", json.dumps(report, ensure_ascii=True))
+    except Exception as exc:
+        # Do not put URLs, credentials, paths or participant data into startup logs.
+        log.error("document_rename_startup_failed reason=%s", type(exc).__name__)
diff --git a/tests/test_startup_document_rename.py b/tests/test_startup_document_rename.py
new file mode 100644
--- /dev/null
+++ b/tests/test_startup_document_rename.py
@@ -0,0 +1,92 @@
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from models import UploadedDocumentRename
+from scripts import rename_uploaded_documents as rename_script
+from scripts.deployment.startup_document_rename import run_startup_document_rename
+from services.nextcloud_storage import NextcloudStorage
+
+
+@pytest.fixture
+def startup(monkeypatch):
+    monkeypatch.delenv("AUTO_RENAME_UPLOADED_DOCUMENTS", raising=False)
+    monkeypatch.setenv("FLASK_ENV", "production")
+    app = SimpleNamespace(config={"DATABASE_URL": "postgresql://example/db"}, logger=Mock())
+    storage = NextcloudStorage("https://cloud.test", "user", "secret")
+    engine = SimpleNamespace(dialect=SimpleNamespace(name="postgresql"))
+    sessions = SimpleNamespace(kw={"bind": engine})
+    container = SimpleNamespace(storage=storage, submission_repository=SimpleNamespace(session_factory=sessions))
+    readiness = Mock(return_value={"status": "ready"})
+    inspector = Mock()
+    inspector.has_table.return_value = True
+    inspector.get_columns.return_value = [{"name": c.name} for c in UploadedDocumentRename.__table__.columns]
+    monkeypatch.setattr("sqlalchemy.inspect", lambda engine: inspector)
+    auto = Mock(return_value={"phase": "verify", "errors": [], "result": {"applied": 2}})
+    monkeypatch.setattr(rename_script, "_automatic_migration", auto)
+    return app, container, readiness, inspector, auto
+
+
+def test_startup_calls_existing_auto_with_application_services(startup):
+    app, container, readiness, _, auto = startup
+    run_startup_document_rename(app, container, readiness)
+    auto.assert_called_once()
+    renamer = auto.call_args.args[0]
+    assert renamer.storage is container.storage
+    assert renamer.session_factory is container.submission_repository.session_factory
+    assert any("completed" in call.args[0] for call in app.logger.info.call_args_list)
+
+
+@pytest.mark.parametrize("reason", ["disabled", "testing", "local", "tls", "schema", "journal", "columns", "storage"])
+def test_startup_skips_unsafe_or_disabled_migration(startup, monkeypatch, reason):
+    app, container, readiness, inspector, auto = startup
+    if reason == "disabled":
+        monkeypatch.setenv("AUTO_RENAME_UPLOADED_DOCUMENTS", "false")
+    elif reason == "testing":
+        app.config["TESTING"] = True
+    elif reason == "local":
+        monkeypatch.setenv("FLASK_ENV", "development")
+    elif reason == "tls":
+        container.storage.verify_ssl = False
+    elif reason == "schema":
+        readiness.return_value = {"status": "not_ready"}
+    elif reason == "journal":
+        inspector.has_table.return_value = False
+    elif reason == "columns":
+        inspector.get_columns.return_value = []
+    elif reason == "storage":
+        container.storage = object()
+    run_startup_document_rename(app, container, readiness)
+    auto.assert_not_called()
+
+
+def test_startup_can_opt_in_outside_production(startup, monkeypatch):
+    app, container, readiness, _, auto = startup
+    monkeypatch.setenv("FLASK_ENV", "development")
+    monkeypatch.setenv("AUTO_RENAME_UPLOADED_DOCUMENTS", "true")
+    run_startup_document_rename(app, container, readiness)
+    auto.assert_called_once()
+
+
+def test_startup_lock_contention_is_not_failure(startup):
+    app, container, readiness, _, auto = startup
+    auto.side_effect = rename_script.RenameError("locked", "MIGRATION_LOCKED")
+    run_startup_document_rename(app, container, readiness)
+    app.logger.error.assert_not_called()
+    assert any("MIGRATION_LOCKED" in call.args[0] for call in app.logger.info.call_args_list)
+
+
+def test_startup_logs_report_error_without_crashing(startup):
+    app, container, readiness, _, auto = startup
+    auto.return_value = {"phase": "dry-run", "errors": [{"reason_code": "UNEXPECTED_ERROR"}]}
+    run_startup_document_rename(app, container, readiness)
+    app.logger.error.assert_called_once()
+
+
+def test_startup_logs_exception_without_sensitive_message(startup):
+    app, container, readiness, _, auto = startup
+    auto.side_effect = RuntimeError("sensitive information")
+    run_startup_document_rename(app, container, readiness)
+    app.logger.error.assert_called_once()
+    assert "sensitive information" not in str(app.logger.error.call_args)
